rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user may only read and write their own profile document.
    // No client can read or list another user's data.
    //
    // NOTE: this update rule isn't restricted to specific fields, so it
    // isn't a safe place to add anything money-related (e.g. a future
    // `isPremium` flag) without either field-level validation here or,
    // better, a server-validated write via a Cloud Function checking a
    // purchase receipt. Premium/monetization was removed from v1 (see
    // `TODO.md`) rather than shipped as a client-writable demo flag.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // The optional lastActiveAt check backs the FCM push-notification
      // dedup mechanism (see functions/src/lib/presence.ts): the client
      // heartbeats this field while the app is alive so Cloud Functions can
      // tell "local notifications already cover this" from "app is closed,
      // push is needed." Left optional — every other preference write
      // (theme, language, etc.) never touches this field, and requiring it
      // unconditionally would break those writes for a user who has never
      // enabled notifications. (request.resource only applies to writes, so
      // this check can't live in the read rule above.)
      allow update: if request.auth != null
        && request.auth.uid == userId
        && (!('lastActiveAt' in request.resource.data)
          || request.resource.data.lastActiveAt is timestamp);
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email;
      // Account deletion (Settings) deletes this doc first, as its own
      // commit, before clearing the subcollections below — see the
      // `categories` rule's delete exception for why the ordering matters.
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Each user's accounts, categories, transactions, etc. live in
      // subcollections under their own profile document so ownership is
      // enforced by the path itself.
      match /accounts/{accountId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.type in
            ['cash', 'wallet', 'bank', 'creditCard', 'savings']
          && request.resource.data.balance is number
          && request.resource.data.currencyCode is string
          && request.resource.data.currencyCode.size() > 0
          && request.resource.data.icon is string
          && request.resource.data.color is string
          && request.resource.data.isArchived is bool;
        // currencyCode is fixed at creation: every transaction/budget/
        // report/Smart-Money-Score figure attributes an amount to a
        // currency via *this* field (see CLAUDE.md's Coding Standards), so
        // changing it after the fact would silently reclassify every
        // already-recorded amount tied to this account into a different
        // currency with no conversion. Pinned here the same way categories'
        // isDefault and budgets' categoryId/month already are.
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.type in
            ['cash', 'wallet', 'bank', 'creditCard', 'savings']
          && request.resource.data.balance is number
          && request.resource.data.currencyCode == resource.data.currencyCode
          && request.resource.data.icon is string
          && request.resource.data.color is string
          && request.resource.data.isArchived is bool;
      }

      match /categories/{categoryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Default categories are seeded by the user themselves (client-side
        // batch) but can never be deleted, only archived — *unless* the
        // user's whole profile doc is already gone, which only happens as
        // step 1 of full account deletion (see auth_remote_datasource.dart
        // `deleteAccount`). That ordering is what makes this exception safe:
        // there's no way to make the profile doc "disappear" while still
        // using the app normally, so this can't be used to route around the
        // default-category delete protection any other way.
        allow delete: if request.auth != null
          && request.auth.uid == userId
          && (resource.data.isDefault == false
            || !exists(/databases/$(database)/documents/users/$(userId)));
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.icon is string
          && request.resource.data.color is string
          && request.resource.data.isDefault is bool
          && request.resource.data.isArchived is bool
          && request.resource.data.sortOrder is number;
        // `isDefault` is fixed at creation (CategoryEntity.copyWith doesn't
        // even expose it) — pinned here too so a client can't flip a
        // default category's flag to false and then delete it, bypassing
        // the delete rule above.
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.icon is string
          && request.resource.data.color is string
          && request.resource.data.isDefault is bool
          && request.resource.data.isDefault == resource.data.isDefault
          && request.resource.data.isArchived is bool
          && request.resource.data.sortOrder is number;
      }

      match /transactions/{transactionId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        // categoryId and toAccountId are always present as strings — ''
        // for whichever one doesn't apply to this transaction's type —
        // rather than an absent field, so every rule below can check
        // `.size() > 0` uniformly instead of a separate "field exists"
        // check. income/expense need a real categoryId and no
        // toAccountId; transfer needs a real, distinct toAccountId and no
        // categoryId.
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.accountId is string
          && request.resource.data.accountId.size() > 0
          && request.resource.data.categoryId is string
          && request.resource.data.toAccountId is string
          && request.resource.data.type in ['income', 'expense', 'transfer']
          && (request.resource.data.type == 'transfer'
            ? (request.resource.data.categoryId.size() == 0
              && request.resource.data.toAccountId.size() > 0
              && request.resource.data.toAccountId != request.resource.data.accountId
              // Cashly never converts currency on a transfer (see CLAUDE.md's
              // Coding Standards) — moving "30" out of one account has to
              // land as 30 of that same currency, not 30 of whatever the
              // destination happens to use. The app form already restricts
              // the destination picker to same-currency accounts; this get()
              // check is what makes that a real guarantee instead of a
              // client-only convention a direct API write could bypass.
              && get(/databases/$(database)/documents/users/$(userId)/accounts/$(request.resource.data.accountId)).data.currencyCode
                == get(/databases/$(database)/documents/users/$(userId)/accounts/$(request.resource.data.toAccountId)).data.currencyCode)
            : (request.resource.data.categoryId.size() > 0
              && request.resource.data.toAccountId.size() == 0))
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.date is timestamp
          && request.resource.data.note is string;
      }

      match /budgets/{budgetId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.categoryId is string
          && request.resource.data.categoryId.size() > 0
          && request.resource.data.month is timestamp
          && request.resource.data.limitAmount is number
          && request.resource.data.limitAmount > 0
          && request.resource.data.currencyCode is string
          && request.resource.data.currencyCode.size() > 0;
        // `categoryId`/`month` are fixed at creation (BudgetEntity.copyWith
        // only exposes limitAmount/currencyCode, and the document ID itself
        // is derived from `{categoryId}_{yyyy-MM}` — see budget_remote_
        // datasource.dart) — pinned here too so a client can't repoint an
        // existing budget document at a different category/month via a
        // raw update, which would desync the ID from its own fields.
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.categoryId == resource.data.categoryId
          && request.resource.data.month == resource.data.month
          && request.resource.data.limitAmount is number
          && request.resource.data.limitAmount > 0
          && request.resource.data.currencyCode is string
          && request.resource.data.currencyCode.size() > 0;
      }

      // One document per `{yyyy-MM}_{currency}` keeps a Smart Money Score's
      // opening balance durable across devices. The client may refresh the
      // latest deterministic calculation, but it can never rewrite an
      // existing month's opening fields or delete history.
      match /smartMoneyScores/{scoreId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.monthStart is timestamp
          && request.resource.data.monthKey is string
          && request.resource.data.currencyCode is string
          && request.resource.data.currencyCode.size() > 0
          && scoreId == request.resource.data.monthKey + '_'
            + request.resource.data.currencyCode
          && request.resource.data.openingBalance is number
          && request.resource.data.baselineState in
            ['reliable', 'insufficientData', 'unsafeCurrencyMovement']
          && request.resource.data.baselineNote is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.monthStart == resource.data.monthStart
          && request.resource.data.monthKey == resource.data.monthKey
          && request.resource.data.currencyCode == resource.data.currencyCode
          && request.resource.data.openingBalance == resource.data.openingBalance
          && request.resource.data.baselineState == resource.data.baselineState
          && request.resource.data.baselineNote == resource.data.baselineNote
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.latestCalculation is map;
        allow delete: if false;
      }

      match /savingsGoals/{goalId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        // No currencyCode field here at all, unlike accounts/budgets — a
        // goal's currency is always derived live from its linked account,
        // which stays the single source of truth rather than caching a
        // second copy here that could drift out of sync with it.
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.targetAmount is number
          && request.resource.data.targetAmount > 0
          && request.resource.data.accountId is string
          && request.resource.data.accountId.size() > 0
          && request.resource.data.icon is string
          && request.resource.data.color is string
          && request.resource.data.isArchived is bool
          && request.resource.data.autoContributionAmount is number
          && request.resource.data.autoContributionAmount >= 0
          && request.resource.data.autoContributionFrequency in
            ['', 'weekly', 'biweekly', 'monthly']
          && request.resource.data.lastContributionAt is timestamp;
        // accountId pinned immutable: repointing a goal at a different
        // account after creation would desync it from whatever account
        // actually backed its past contributions (see
        // ContributeToGoalUseCase — contributions are transfers into
        // accountId, so progress and history both key off it staying put).
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.accountId == resource.data.accountId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.targetAmount is number
          && request.resource.data.targetAmount > 0
          && request.resource.data.icon is string
          && request.resource.data.color is string
          && request.resource.data.isArchived is bool
          && request.resource.data.autoContributionAmount is number
          && request.resource.data.autoContributionAmount >= 0
          && request.resource.data.autoContributionFrequency in
            ['', 'weekly', 'biweekly', 'monthly']
          && request.resource.data.lastContributionAt is timestamp;
      }

      match /fcmTokens/{tokenId} {
        // Document ID *is* the token value (same "ID encodes the natural
        // key" convention as budgets' {categoryId}_{yyyy-MM}) — so
        // registering/removing a specific token is a direct doc reference,
        // never an array scan.
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && tokenId == request.resource.data.token
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp;
        // createdAt pinned immutable: a token refresh should only ever bump
        // updatedAt, same reasoning as budgets'/savingsGoals' pinned fields.
        allow update: if request.auth != null
          && request.auth.uid == userId
          && tokenId == request.resource.data.token
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt is timestamp;
      }

      match /notificationState/{stateId} {
        // Written only by Cloud Functions (Admin SDK), never the client —
        // the durable, cross-invocation version of budget_alert_providers
        // .dart's in-memory _AlertedIds, deciding whether a given
        // budget/account/goal crossing has already been pushed. Explicit
        // deny here (redundant with the trailing catch-all) purely so this
        // collection's existence and ownership is documented in-place
        // rather than only discoverable by reading functions/ code.
        allow read, write: if false;
      }
    }

    // Deny everything else by default until a feature explicitly needs it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
